{
  "name": "il-12-dispatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "bun run typegen && bun run tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test",
    "typegen": "bunx sanity@latest schema extract --force --enforce-required-fields --path=sanity/extract.json && bunx sanity@latest typegen generate",
    "skills:update": "skills update -y -p && rm -rf .claude",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome format --write",
      "biome check --no-errors-on-unmatched",
      "tsc-files --noEmit --pretty false --incremental false"
    ]
  },
  "dependencies": {
    "@sanity/client": "^8.4.0",
    "@sanity/icons": "^5.2.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.11.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "next": "16.3.3",
    "next-sanity": "^13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.11.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "skills": "1.5.23",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
